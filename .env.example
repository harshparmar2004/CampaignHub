# ==============================================================================
# CampaignHub Environment Variables Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Supabase Database & Auth (Required for apps/web and apps/worker)
# ------------------------------------------------------------------------------
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# Service role key bypasses RLS; keep safe, used in worker and admin web route handlers
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. Redis / BullMQ Queue (Required for apps/worker and queue dispatch)
# ------------------------------------------------------------------------------
# Connect via Upstash Redis or local Redis instance
# Format: rediss://default:token@region.upstash.io:6379 or redis://localhost:6379
REDIS_URL=rediss://default:your-token@your-redis-instance.upstash.io:6379

# ------------------------------------------------------------------------------
# 3. Cryptographic Storage & Signatures (Required)
# ------------------------------------------------------------------------------
# 64-character hexadecimal string (32 bytes) used for AES-256-GCM encryption
# Generate in terminal using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Secret used to sign 1-click unsubscribe links and HMAC webhooks
APP_SECRET=your-secure-random-secret-key-at-least-32-chars

# Base URL of the web application for webhook callbacks and unsubscribe links
NEXT_PUBLIC_APP_URL=https://campaignhub.yourcompany.com

# ------------------------------------------------------------------------------
# 4. Third-Party Provider Credentials
# (Note: These can also be configured and encrypted directly in the Settings UI)
# ------------------------------------------------------------------------------
# Meta WhatsApp Cloud API
# META_ACCESS_TOKEN=EAAG... (Permanent System User Token)
# META_PHONE_NUMBER_ID=102938475610293
# META_WABA_ID=192837465019283
# META_APP_SECRET=a1b2c3d4e5f6...
# META_WEBHOOK_VERIFY_TOKEN=campaignhub_wa_verify_2026

# Resend Email API
# RESEND_API_KEY=re_1234567890abcdef...
# RESEND_FROM_NAME="Acme Campaigns"
# RESEND_FROM_EMAIL="updates@mail.yourcompany.com"

# Telegram Bot API
# TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# TELEGRAM_CHANNEL_ID=@yourcompanychannel or -1001234567890

# ------------------------------------------------------------------------------
# 5. Worker Service Port
# ------------------------------------------------------------------------------
PORT=8080
NODE_ENV=production
